# Provedor padrão do curso: Alchemy. Uma chave cobre Testnet e Mainnet.
# ATENÇÃO: a chave vai NA URL do RPC. Nunca versione este arquivo preenchido,
# e nunca use esta chave em código de frontend.
ALCHEMY_API_KEY=

# testnet | mainnet | futurenet | local
STELLAR_NETWORK=testnet

# Opcional: vence a URL do provedor padrão (nó próprio, outro provedor,
# ou o RPC público de Testnet, que dispensa a chave da Alchemy):
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Necessária apenas para `pay`. Conta de Testnet, nunca uma chave de valor real.
STELLAR_SECRET_KEY=
